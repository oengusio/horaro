{% extends "admin/utils/layout.twig" %}
{% import "macros.twig" as macros %}

{% block title %}Configuration &ndash; Admin{% endblock %}
{% set active = 'config' %}

{% block tabcontent %}
<div class="card card-body">
	<form method="post" action="/-/admin/utils/config">
		<div><input type="hidden" id="_method" name="_method" value="PUT" /></div>
		{{ macros.csrf_token() }}

		<div class="form-group row{{ utils.formClass(result, 'bcrypt_cost') }}">
			<label class="col-lg-3 col-form-label" for="bcrypt_cost">bcrypt cost factor:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-2">
						<input type="number" class="form-control" id="bcrypt_cost" name="bcrypt_cost" required value="{{ utils.formValue(result, 'bcrypt_cost', config.bcrypt_cost) }}" min="6" max="15">
					</div>
				</div>
				{{ macros.form_errors(result, 'bcrypt_cost') }}
				<small class="form-text text-muted">This cost factor has exponential growth. Be careful setting it too high (or hashing passwords will take several seconds).</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'cookie_lifetime') }}">
			<label class="col-lg-3 col-form-label" for="cookie_lifetime">Cookie lifetime:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-4">
						<div class="input-group">
							<input type="text" class="form-control" id="cookie_lifetime" name="cookie_lifetime" required value="{{ utils.formValue(result, 'cookie_lifetime', config.cookie_lifetime) }}">
							<div class="input-group-append"><span class="input-group-text"> seconds</span></div>
						</div>
					</div>
				</div>
				{{ macros.form_errors(result, 'cookie_lifetime') }}
				<small class="form-text text-muted">How long should cookies be stored on the browser side?</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'csrf_token_name') }}">
			<label class="col-lg-3 col-form-label" for="csrf_token_name">CSRF token name:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-4">
						<input type="text" class="form-control" id="csrf_token_name" name="csrf_token_name" required value="{{ utils.formValue(result, 'csrf_token_name', config.csrf_token_name) }}">
					</div>
				</div>
				{{ macros.form_errors(result, 'csrf_token_name') }}
				<small class="form-text text-muted">Must be alphanumeric and should be something unique to this installation, for example <code>csrf_token_kappa</code>. If in doubt, it's okay to leave this setting untouched.</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'default_language') }}">
			<label class="col-lg-3 col-form-label" for="default_language">Default language:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-4">
						{% set lng = utils.formValue(result, 'default_language', config.default_language) %}
						<select name="default_language" id="default_language" class="form-control h-fancy">
						{% for language,name in languages %}
							<option value="{{ language }}"{% if lng == language %} selected{% endif %}>{{ name }}</option>
						{% endfor %}
						</select>
					</div>
				</div>
				{{ macros.form_errors(result, 'default_language') }}
				<small class="form-text text-muted">The language that will be pre-selected as the UI language for new users.</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'default_event_theme') }}">
			<label class="col-lg-3 col-form-label" for="default_event_theme">Default event theme:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-4">
						{% set thm = utils.formValue(result, 'default_event_theme', config.default_event_theme) %}
						<select name="default_event_theme" id="default_event_theme" class="form-control h-fancy">
						{% for themes,name in themes %}
							<option value="{{ themes }}"{% if thm == themes %} selected{% endif %}>{{ name }}</option>
						{% endfor %}
						</select>
					</div>
				</div>
				{{ macros.form_errors(result, 'default_event_theme') }}
				<small class="form-text text-muted">The pre-selected theme for new events.</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'max_users') }}">
			<label class="col-lg-3 col-form-label" for="max_users">Max # of users:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-2">
						<input type="number" class="form-control" id="max_users" name="max_users" required value="{{ utils.formValue(result, 'max_users', config.max_users) }}" min="1">
					</div>
				</div>
				{{ macros.form_errors(result, 'max_users') }}
				<small class="form-text text-muted">
					This limits the number of user accounts that can be created. Keep in mind that registration has no CAPTCHA,
					so flodding the system is relatively easy. This is why you don't want to set this too high.
				</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'max_events') }}">
			<label class="col-lg-3 col-form-label" for="max_events">Max # of events:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-3">
						<div class="input-group">
							<input type="number" class="form-control" id="max_events" name="max_events" required value="{{ utils.formValue(result, 'max_events', config.max_events) }}" min="0">
							<div class="input-group-append"><span class="input-group-text"> per user</span></div>
						</div>
					</div>
				</div>
				{{ macros.form_errors(result, 'max_events') }}
				<small class="form-text text-muted">
					This limits the number of events per user. This can be overriden for each user independently, if necessary.
				</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'max_schedules') }}">
			<label class="col-lg-3 col-form-label" for="max_schedules">Max # of schedules:</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-3">
						<div class="input-group">
							<input type="number" class="form-control" id="max_schedules" name="max_schedules" required value="{{ utils.formValue(result, 'max_schedules', config.max_schedules) }}" min="1">
							<div class="input-group-append"><span class="input-group-text"> per event</span></div>
						</div>
					</div>
				</div>
				{{ macros.form_errors(result, 'max_schedules') }}
				<small class="form-text text-muted">
					This limits the number of schedules per event. This can be overriden for each event independently, if necessary.
				</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'max_schedule_items') }}">
			<label class="col-lg-3 col-form-label" for="max_schedule_items">Max # of items (rows):</label>
			<div class="col-lg-8">
				<div class="row">
					<div class="col-lg-4">
						<div class="input-group">
							<input type="number" class="form-control" id="max_schedule_items" name="max_schedule_items" required value="{{ utils.formValue(result, 'max_schedule_items', config.max_schedule_items) }}" min="1">
							<div class="input-group-append"><span class="input-group-text"> per schedule</span></div>
						</div>
					</div>
				</div>
				{{ macros.form_errors(result, 'max_schedule_items') }}
				<small class="form-text text-muted">
					This limits the number of items per schedule. This can be overriden for each schedule independently, if necessary.
				</small>
			</div>
		</div>

		<div class="form-group row{{ utils.formClass(result, 'sentry_dsn') }}">
			<label class="col-lg-3 col-form-label" for="sentry_dsn">Sentry DSN:</label>
			<div class="col-lg-9">
				<input type="text" class="form-control" id="sentry_dsn" name="sentry_dsn" value="{{ utils.formValue(result, 'sentry_dsn', config.sentry_dsn) }}">
				{{ macros.form_errors(result, 'sentry_dsn') }}
				<small class="form-text text-muted">If you don't know what this is, leave it empty.</small>
			</div>
		</div>

		<div class="form-group row">
			<div class="offset-lg-3 col-lg-3">
				<button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-check"></i> Update Configuration</button>
			</div>
		</div>
	</form>
</div>
{% endblock %}
