{% extends "frontend/layout.twig" %}
{% import "macros.twig" as macros %}


{% block title %}Awww snap!{% endblock %}
{% block navigation %}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-6 offset-lg-3 col-md-6 offset-md-3 col-sm-6 offset-sm-3 col-8 offset-2">
            <p>
                <img src="{{ asset('images/error-500.png') }}" alt="" class="img-fluid">
            </p>
        </div>

        <div class="col-lg-6 offset-lg-3 col-md-8 offset-md-2 col-sm-9 offset-sm-1 col-12">
            <h3>Awww snap! <small>Something has gone terribly wrong on our end.</small></h3>
            <p>We apologise for the fault in the system. Those responsible have been sacked.</p>
            <p class="text-center text-danger h-jail">{{ exception.message }}</p>
            <p class="text-center">{{ macros.back_button() }}</p>
        </div>
    </div>
{% endblock %}
