{% extends "frontend/layout.twig" %}
{% import "macros.twig" as macros %}

{% block title %}Not Found{% endblock %}
{% block navigation %}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-4 offset-lg-4 col-md-4 offset-md-4 col-sm-4 offset-sm-4 col-4 offset-4">
            <p class="text-center">
                <img src="{{ asset('images/error-404.png') }}" alt="OMG 404 Not Found" class="img-fluid">
            </p>
            <h3>Sometimes, <small>life just sucks.</small></h3>
            <p class="text-center text-danger h-jail">{{ exception.message }}</p>
            <p class="text-center">{{ macros.back_button() }}</p>
        </div>
    </div>
{% endblock %}
