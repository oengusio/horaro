{% extends "frontend.twig" %}
{% import "macros.twig" as macros %}

{% block navigation %}{% endblock %}
{% block title %}Log-in{% endblock %}

{% block login_form %}
    <div class="card card-body">
        {% if error is defined and error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            {#{{ macros.csrf_token() }}#}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <fieldset>
                <div class="form-group row">
                    <label class="col-lg-3 col-form-label" for="login">Username:</label>
                    <div class="col-lg-9">
                        <input type="text" class="form-control" id="login" name="_username" autofocus required
                               value="{{ last_login }}">
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-lg-3 col-form-label" for="password">Password:</label>
                    <div class="col-lg-9">
                        <input type="password" class="form-control" id="password" name="_password" required>
                    </div>
                </div>

                {# TODO: do we always want to force this redirect? #}
                <input type="hidden" name="_target_path" value="/">

                <div class="form-group row">
                    <div class="col-lg-12 text-center">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-arrow-right-to-bracket"></i> Log-in
                        </button>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>

    {% if error_message is defined %}
        <div class="alert alert-danger">{{ error_message }}</div>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="row">
        {% if oauth_settings is empty %}
            <div
                class="col-lg-6 offset-lg-3 col-md-6 offset-md-3 col-sm-6 offset-sm-3 col-8 offset-2">
                <h2>Log-in</h2>
                {{ block('login_form') }}
            </div>
        {% else %}
            <div class="col-lg-5 offset-lg-1 col-md-6 col-sm-6 col-12">
                <h3>Log-in via Twitch</h3>
                <p>Click the button below to log-in with your Twitch account.</p>
                <p class="text-center">{{ macros.twitch_oauth_starter() }}</p>
            </div>

            <div class="col-lg-5 col-md-6 col-sm-6 col-12">
                <h3>Classic Account</h3>
                {{ block('login_form') }}
            </div>
        {% endif %}
    </div>
{% endblock %}
