{% extends "backend.twig" %}

{% set start   = schedule.localStart %}
{% set numCols = columns|length      %}
{% set fluid   = numCols > 3         %}

{% block title %}{{ schedule.name }} &ndash; {{ schedule.event.name }}{% endblock %}
{% block body_attr %} class="theme-horaro" data-ui="scheduler"{% endblock %}

{% block content %}
<nav aria-label="breadcrumb">
<ol class="breadcrumb h-jail">
	<li class="breadcrumb-item"><a href="/-/home">Home</a></li>
	<li class="breadcrumb-item"><a href="/-/events/{{ schedule.event.id|obscurify('event') }}">{{ schedule.event.name|shorten(45) }}</a></li>
	<li class="breadcrumb-item active">{{ schedule.name|shorten(45) }}</li>
</ol>
</nav>

<div class="row h-scheduler-header">
	<div class="col-lg-8 col-md-8 col-sm-8 col-8">
		<h2 class="h-jail"><a href="{{ schedule.link }}" target="_blank">{{ schedule.name|shorten(45) }}</a> <sup><small><i class="fa-solid fa-arrow-up-right-from-square"></i></small></sup></h2>
	</div>

	<div class="col-lg-4 col-md-4 col-sm-4 col-4">
		<div class="btn-group float-right">
			<button type="button" class="btn dropdown-toggle btn-sm" data-toggle="dropdown">
				<i class="fa-solid fa-gear"></i> Actions
			</button>
			<div class="dropdown-menu" role="menu">
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/edit"><i class="fa-regular fa-calendar-days"></i> Edit schedule…</a>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/columns/edit"><i class="fa-solid fa-table-columns"></i> Edit columns…</a>
				<div class="dropdown-divider"></div>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/export?format=json"><i class="fa-solid fa-floppy-disk"></i> Export as JSON</a>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/export?format=xml"><i class="fa-solid fa-floppy-disk"></i> Export as XML</a>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/export?format=ical"><i class="fa-solid fa-floppy-disk"></i> Export as iCal</a>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/export?format=csv"><i class="fa-solid fa-floppy-disk"></i> Export as CSV</a>
				<div class="dropdown-divider"></div>
				<a class="dropdown-item" href="/-/schedules/{{ schedule.id|obscurify('schedule') }}/import"><i class="fa-solid fa-upload"></i> Import…</a>
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-lg-12 text-center">
		<h4>Starts on <strong><time datetime="{{ start.format('Y-m-d\\TH:i:sP') }}" class="h-fancy">{{ start.format('Y-m-d H:i:s') }}</time></strong> (<span title="UTC{{ start.format('P') }}" class="h-tooltip">{{ schedule.timezone }}</span> time)</h4>
	</div>
</div>

<div class="row">
	<div class="col-lg-12">
		<p class="text-center text-muted"><small>
			Click on an item to edit its details. Use the buttons on the right to move rows up and down or delete them entirely.<br>
			You can use basic Markdown (<strong>**bold**</strong>, <em>*italic*</em>, [link name](http://example.com/)) for formatting.
			{% if schedule.setupTime %}
			<br>Note: The <strong>{{ utils.readableTime(schedule.setupTime) }} setup time</strong> in between all rows is added automatically.
			{% endif %}
		</small></p>
	</div>
</div>

{# TODO: find a better way of injecting columns #}
<script>
window.scheduleColumns = [
{% for idx,column in schedule.columns|slice(0,10) %}
    {name: {{ column.name|json_encode|raw }}, id: {{ column.id|obscurify('schedule.column')|json_encode|raw }}},
{% endfor %}
];

// Welcome to the dirtiest hacks, today we will just say fuck it because the application does not have access to the column names
window.optionsColumnId = '{{ optionsColumnId }}';
window.scheduleId = '{{ schedule.id|obscurify('schedule') }}';
window.scheduleStart = new Date('{{ start.format('Y-m-d\\TH:i:sP') }}');
window.scheduleSetupTime = {{ schedule.setupTimeInSeconds }};
window.scheduleTZ = '{{ start.format('P') }}';
window.maxItems = {{ maxItems }};

window.itemData = {{ items|json_encode|raw }};

// TODO: probably not going to use this
window.testColumns = '{{ columns|join(',') }}';
</script>

<div {{ vue_component('HoraroInputPopover') }}></div>

<div {{ vue_component('SchedulerContainer', {
    'numCols': numCols,
    'scheduledText': schedule.text('col-scheduled')|default('Scheduled'),
    'estimateText': schedule.text('col-estimate')|default('Estimate'),
}) }}>
    <div class="row" id="h-scheduler-loading">
        <div class="col-lg-12">
            <div class="spinner">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>
    </div>
</div>

<script>

</script>
<script type="application/json" id="h-item-data">
{{ items|json_encode|raw }}
</script>
{% endblock %}
