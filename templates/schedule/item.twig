{# Do not use the ternary operator because the secure bindings for Knockout do not support them. #}
<tbody class="h-schedule-item" {{ stimulus_controller('schedule-item', { 'item': 'ITEM_PLACEHOLDER', 'index': 'INDEX_PLACEHOLDER' }) }} draggable="true">
	<!-- ko if: dateSwitch -->
	<tr class="h-new-day" hidden>
		<td colspan="{{ numCols + 4 }}" data-bind="text: dateSwitch"></td>
	</tr>
	<!-- /ko -->

	<tr class="h-primary">
		<td class="h-s" data-bind="attr: { class: 'h-s ' + rowClass() }"><span data-bind="text: formattedSchedule"></span></td>
		<td class="h-l" data-bind="attr: { class: 'h-l ' + rowClass() }">
			<!-- ko if: errors -->
			<a href="#" data-bind="editable: formattedLength, editableOptions: { hidden: onEditableHidden }, attr: { title: errors().length[0] }"></a>
			<!-- /ko -->

			<!-- ko if: !errors() -->
			<a href="#" data-bind="editable: formattedLength, editableOptions: { hidden: onEditableHidden }"></a>
			<!-- /ko -->
		</td>

		{% for idx,column in columns|slice(0,10) %}
		<td class="h-{{ idx }}" data-bind="attr: { class: 'h-{{ idx }} ' + rowClass() }">
            <a href="#" id="col_{{ column.id|obscurify('schedule.column') }}" data-bind="editable: col_{{ column.id|obscurify('schedule.column') }}, editableOptions: { hidden: onEditableHidden, display: getDisplayText }"></a>
        </td>
		{% endfor %}

		<td class="h-co text-right" data-bind="attr: { class: 'h-co text-right ' + rowClass() }">
			<!-- ko if: !deleting() -->
			<span>
				<button class="btn btn-link btn-sm" data-bind="click: toggle, activate: toggle, visible: !expanded()"><i class="fa-solid fa-angles-down"></i> more</button>
				<button class="btn btn-link btn-sm" data-bind="click: toggle, activate: toggle, visible: expanded"><i class="fa-solid fa-angles-up"></i> less</button>
			</span>
			<button data-bind="click: moveUp, activate: moveUp, attr: { class: 'btn move-up btn-sm' + (first() && ' disabled' || ' btn-secondary') }"><i class="fa-solid fa-arrow-up"></i></button>
			<button data-bind="click: moveDown, activate: moveDown, attr: { class: 'btn move-down btn-sm' + (last() && ' disabled' || ' btn-secondary') }"><i class="fa-solid fa-arrow-down"></i></button>
			<button data-bind="click: confirmDelete, activate: confirmDelete, attr: { class: 'btn btn-danger btn-sm' + (id() === -1 && ' disabled' || '') }"><i class="fa-solid fa-trash"></i></button>
			<!-- /ko -->

			<!-- ko if: deleting() -->
			<button class="btn btn-danger btn-sm" data-bind="click: doDelete, activate: doDelete"><i class="fa-solid fa-trash"></i></button>
			<button class="btn btn-secondary btn-sm" data-bind="click: cancelDelete, activate: cancelDelete"><i class="fa-solid fa-rotate-left"></i></button>
			<!-- /ko -->
		</td>
	</tr>

	<!-- ko if: expanded -->
	<tr class="h-secondary">
		<td colspan="{{ numCols + 3 }}">
			<dl class="row">
				{% for idx,column in columns.slice(1) %}
				<dt class="h-e-{{ idx }}">{{ column.name }}:</dt>
				<dd class="h-e-{{ idx }}"><a href="#" data-bind="editable: col_{{ column.id|obscurify('schedule.column') }}, editableOptions: { hidden: onEditableHidden, display: getDisplayText }"></a></dd>
				{% endfor %}
			</dl>
		</td>
	</tr>
	<!-- /ko -->
</tbody>
