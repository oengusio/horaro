{% extends "frontend/layout.twig" %}
{% import "macros.twig" as macros %}

{% set theme    = schedule.theme           %}
{% set columns  = schedule.columns         %}
{% set numCols  = columns|length           %}
{% set fluid    = numCols > 4              %}
{% set appendix = key ? '?key=' ~ key : '' %}

{% block fulltitle %}{{ schedule.name }} &ndash; {{ event.name }}{% endblock %}
{% block body_attr %} class="theme-{{ theme }}"{% endblock %}

{% block meta %}
<meta name="description" content="Description of the iCal calendar feed for the {{ schedule.name }} of {{ event.name }}">
	<meta name="author" content="{{ event.owner.displayName }}">
	<link rel="canonical" href="{{ app.request.scheme }}://{{ app.request.host }}/{{ event.slug }}/{{ schedule.slug }}/ical-feed{{ appendix }}">
	<link rel="index" href="{{ app.request.scheme }}://{{ app.request.host }}/{{ event.slug ~ appendix }}">
	{% if isPrivate %}<meta name="robots" content="noindex">
{% endif %}
{% endblock %}

{% block styles %}
<link href="{{ asset('styles/theme/theme-' ~ theme ~ '.min.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ macros.asset('vendor/@fortawesome/fontawesome-free/css/fontawesome.min.css') }}"/>
	<link href="{{ asset('styles/app-frontend.css') }}" rel="stylesheet">
{% endblock %}

{% block navheader %}
<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#h-collapse-nav" aria-controls="h-collapse-nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
<a href="/{{ event.slug ~ appendix }}" class="navbar-brand">{{ event.name }}</a>
{% endblock %}

{% block navigation %}
<ul class="navbar-nav mr-auto">
	{% if schedules|length == 1 %}
	<li class="nav-item"><a href="/{{ event.slug }}/{{ schedules[0].slug ~ appendix }}" class="nav-link h-jail"><i class="fa-regular fa-calendar-days"></i> {{ schedules[0].name == event.name ? 'Schedule' : schedules[0].name }}</a></li>
	{% else %}
	<li class="nav-item dropdown">
		<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-regular fa-calendar-days"></i> Schedules</a>
		<div class="dropdown-menu">
			{% for sched in schedules %}
			<a href="/{{ event.slug }}/{{ sched.slug ~ appendix }}" class="dropdown-item h-jail">{{ sched.name }}</a>
			{% endfor %}
		</div>
	</li>
	{%	endif %}
	<li class="nav-item dropdown">
		<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-wrench"></i> Tools</a>
		<div class="dropdown-menu">
			<a href="/{{ event.slug }}/{{ schedule.slug }}/ical-feed{{ appendix }}" class="dropdown-item"><i class="fa-regular fa-calendar-days"></i> iCal Feed</a>
			<div class="dropdown-divider"></div>
			<a href="/{{ event.slug }}/{{ schedule.slug }}.json?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i class="fa-solid fa-download"></i> Export as JSON</a>
			<a href="/{{ event.slug }}/{{ schedule.slug }}.xml?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i class="fa-solid fa-download"></i> Export as XML</a>
			<a href="/{{ event.slug }}/{{ schedule.slug }}.csv?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i class="fa-solid fa-download"></i> Export as CSV</a>
		</div>
	</li>
</ul>

{% set website = schedule.website|default(event.website) %}
{% set twitch  = schedule.twitch|default(event.twitch)   %}
{% set twitter = schedule.twitter|default(event.twitter) %}

<ul class="navbar-nav ml-auto">
    {% if website %}
        <li class="nav-item"><a href="{{ website }}" target="_blank" title="{{ website }}" class="nav-link"><i class="fa-solid fa-globe"></i> <span
                class="d-none d-md-inline">Website</span></a></li>{% endif %}
    {% if twitch %}
        <li class="nav-item"><a href="https://twitch.tv/{{ twitch }}" target="_blank" title="{{ twitch }}" class="nav-link"><i
                class="fa-brands fa-twitch"></i> <span class="d-none d-md-inline">{{ twitch }}</span></a></li>{% endif %}
    {% if event.bluesky %}
        <li class="nav-item"><a href="https://bsky.app/profile/{{ event.bluesky }}" target="_blank" title="@{{ event.bluesky }}" class="nav-link"><i
                class="fa-brands fa-bluesky"></i> <span class="d-none d-md-inline">@{{ event.bluesky }}</span></a>
        </li>{% endif %}
    {% if twitter %}
        <li class="nav-item"><a href="https://twitter.com/{{ twitter }}" target="_blank" title="@{{ twitter }}" class="nav-link"><i
                class="fa-brands fa-twitter"></i> <span class="d-none d-md-inline">@{{ twitter }}</span></a></li>{% endif %}
</ul>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-lg-12 col-md-12 col-sm-12 col-12">
		<h2 class="h-jail">{{ schedule.name }} <small>iCal Feed</small></h2>
	</div>
</div>

<div class="row">
	<div class="col-lg-12 col-md-12 col-sm-12 col-12">
		<p class="text-center"><a href="/{{ event.slug }}/{{ schedule.slug ~ appendix }}" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back to the Schedule</a></p>
	</div>
</div>

<div class="row">
	<div class="col-lg-12 col-md-12 col-sm-12 col-12">
		<p>
			<img src="{{ asset('images/google-calendar-example.png') }}" alt="Example screenshot of Google Calendar, displaying a few calendar entries from the GTA Marathon schedule" class="img-thumbnail float-right">
			iCal is a data format for transmitting calendar entries. Lots of calendar applications like
			Thunderbird, Google Calendar, Outlook or iCalendar support im- and exporting iCal files.
			Despite its name, it is not something exclusive to the Apple universe.
		</p>

		<h3>How does this help me?</h3>

		<p>You can get an iCal version of the schedule, so you can import it and have the dates and times
		of it readily available in your personal calendar. Then you can for example set reminders on
		certain schedule items, so you never miss the most important things to you.</p>

		<h3>Tell me how!</h3>

		<p>You have two options here: Doing a one-time import or subscribing to the schedule. Subscribing
		is definitely the recommended way, because your calendar will be kept up to date as the schedule
		changes.</p>

		<p>To just import the schedule once, <a href="/{{ event.slug }}/{{ schedule.slug }}.ical?named=true{{ key ? '&key=' ~ key : '' }}">download the iCal file</a>
		and use your calendar's import function on it. Don't let the file extension (<code>.ics</code>) of
		your download distract you: iCal data is simply stored in <code>.ics</code> files.</p>

		<p>If your calendar supports it, you really should subscribe to the schedule instead. This
		makes sure your calendar does not go out-of-sync over time. To subscribe, you will need to
		copy and paste the following URL in your calendar:</p>

		<p class="text-center"><code>{{ app.request.getUriForPath('/' ~ event.slug ~ '/' ~ schedule.slug ~ '.ical') }}{{ appendix }}</code></p>

		<p>That's already it.</p>
	</div>
</div>
{% endblock %}
