{% extends "frontend/layout.twig" %}
{% import "macros.twig" as macros %}

{% set theme     = schedule.theme %}
{% set start     = schedule.localStart %}
{% set columns   = schedule.visibleColumns %}
{% set numCols   = columns|length %}
{% set fluid     = numCols > 4 %}
{% set appendix  = key ? '?key=' ~ key : '' %}
{# needsSeconds calls scheduledItems which uses the iterator #}
{% set precision = schedule.needsSeconds ? 'seconds' : 'minutes' %}
{% set dtformat  = precision == 'seconds' ? 'H:i:s' : 'H:i' %}

{% block fulltitle %}{{ schedule.name }} &ndash; {{ event.name }}{% endblock %}
{% block body_attr %} class="theme-{{ theme }}"{% endblock %}

{% block meta %}
    <meta name="description" content="{{ schedule.name }} of {{ event.name }}">
    <meta name="author" content="{{ event.owner.displayName }}">
    <link rel="canonical"
          href="{{ app.request.scheme }}://{{ app.request.host }}/{{ event.slug }}/{{ schedule.slug ~ appendix }}">
    <link rel="index" href="{{ app.request.scheme }}://{{ app.request.host }}/{{ event.slug ~ appendix }}">
    {% if isPrivate %}
        <meta name="robots" content="noindex">
    {% endif %}
{% endblock %}

{% block styles %}
    <link href="{{ asset('styles/theme/theme-' ~ theme ~ '.min.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ macros.asset('vendor/@fortawesome/fontawesome-free/css/fontawesome.min.css') }}"/>
    <link href="{{ asset('styles/app-frontend.css') }}" rel="stylesheet">
{% endblock %}

{% block navheader %}
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#h-collapse-nav" aria-controls="h-collapse-nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
    <a href="/{{ event.slug ~ appendix }}" class="navbar-brand">{{ event.name }}</a>
{% endblock %}

{% block navigation %}
    <ul class="navbar-nav mr-auto">
        {% if schedules|length == 1 %}
            <li class="nav-item"><a href="/{{ event.slug }}/{{ schedules[0].slug ~ appendix }}" class="nav-link h-jail"><i
                        class="fa-regular fa-calendar-days"></i> {{ schedules[0].name == event.name ? 'Schedule' : schedules[0].name }}
                </a></li>
        {% elseif schedules|length != 0 %}
            <li class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-regular fa-calendar-days"></i> Schedules</a>
                <ul class="dropdown-menu">
                    {% for sched in schedules %}
                        <li><a href="/{{ event.slug }}/{{ sched.slug ~ appendix }}" class="dropdown-item h-jail">{{ sched.name }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-wrench"></i> Tools</a>
            <ul class="dropdown-menu">
                <li><a href="/{{ event.slug }}/{{ schedule.slug }}/ical-feed{{ appendix }}" class="dropdown-item"><i
                            class="fa-regular fa-calendar-days"></i> iCal Feed</a></li>
                <div class="dropdown-divider"></div>
                <li><a href="/{{ event.slug }}/{{ schedule.slug }}.json?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i
                            class="fa-solid fa-download"></i> Export as JSON</a></li>
                <li><a href="/{{ event.slug }}/{{ schedule.slug }}.xml?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i
                            class="fa-solid fa-download"></i> Export as XML</a></li>
                <li><a href="/{{ event.slug }}/{{ schedule.slug }}.csv?named=true{{ key ? '&key=' ~ key : '' }}" class="dropdown-item"><i
                            class="fa-solid fa-download"></i> Export as CSV</a></li>
            </ul>
        </li>
    </ul>

    {% set website = schedule.website|default(event.website) %}
    {% set twitch  = schedule.twitch|default(event.twitch) %}
    {% set twitter = schedule.twitter|default(event.twitter) %}
    {% set bluesky = schedule.bluesky|default(event.bluesky) %}

    <ul class="navbar-nav ml-auto">
        {% if website %}
            <li class="nav-item"><a href="{{ website }}" target="_blank" title="{{ website }}" class="nav-link"><i class="fa-solid fa-globe"></i> <span
                    class="d-none d-md-inline">Website</span></a></li>{% endif %}
        {% if twitch %}
            <li class="nav-item"><a href="https://twitch.tv/{{ twitch }}" target="_blank" title="{{ twitch }}" class="nav-link"><i
                    class="fa-brands fa-twitch"></i> <span class="d-none d-md-inline">{{ twitch }}</span></a></li>{% endif %}
        {% if bluesky %}
            <li class="nav-item"><a href="https://bsky.app/profile/{{ bluesky }}" target="_blank" title="@{{ bluesky }}" class="nav-link"><i
                    class="fa-brands fa-bluesky"></i> <span class="d-none d-md-inline">@{{ bluesky }}</span></a>
            </li>{% endif %}
        {% if twitter %}
            <li class="nav-item"><a href="https://twitter.com/{{ twitter }}" target="_blank" title="@{{ twitter }}" class="nav-link"><i
                    class="fa-brands fa-twitter"></i> <span class="d-none d-md-inline">@{{ twitter }}</span></a></li>{% endif %}
    </ul>
{% endblock %}

{% block content %}
    <div itemscope itemtype="https://schema.org/Event">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <h2 class="h-jail" itemprop="name">{{ schedule.name }}</h2>
                {{ description|raw }}
            </div>
        </div>

        {% if schedule.items is empty %}
        <div class="row">
            <div class="col-lg-6 offset-lg-3 col-md-8 offset-md-2 col-sm-9 offset-sm-1 col-12">
                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info"></i> This schedule is currently empty. Check back later.
                </div>
            </div>
        </div>
        {% else %}
        <div class="row">
            <div class="col-lg-12 text-center">
                <h4>Starts on <strong itemprop="startDate">
                        <time datetime="{{ start.format('Y-m-d\\TH:i:sP') }}" class="h-fancy"
                              id="h-schedule-start">{{ start.format('l, F d, Y') }}</time>
                    </strong></h4>
            </div>
        </div>

        <div class="h-ticker row"></div>

        <div class="row">
            <div class="col-lg-12">
                <p class="text-center text-muted" id="localized-note">
                    <small>All dates and times are given in {{ schedule.timezone }} timezone (UTC{{ start.format('P') }}
                           ).</small>
                    <small class="nope">All dates and times are given in your local timezone.</small>
                    <small class="show">The schedule was last updated
                        <time datetime="{{ schedule.localUpdatedAt.format('Y-m-d\\TH:i:sP') }}"
                              class="h-relative h-fuzzy">{{ schedule.localUpdatedAt.format('F d, Y \\a\\t H:i:s') }}</time>
                                        .</small>
                </p>
            </div>
        </div>

        <table class="table h-schedule h-l{{ schedule.getMaxItemWidth(columns) }}" data-columns="{{ numCols }}"
               data-precision="{{ precision }}">
            <thead>
                <tr>
                    {% apply spaceless %}
                        <th class="h-s">{{ schedule.text('col-scheduled')|default('Scheduled') }}</th>
                        <th class="h-0">{{ columns[0].name }}</th>
                        <th class="h-l">{{ schedule.text('col-estimate')|default('Estimate') }}</th>
                        {% for idx,column in columns.slice(1) %}
                            <th class="h-{{ idx }}">{{ column.name }}</th>
                        {% endfor %}
                    {% endapply %}
                </tr>
            </thead>

            {% set old = null %}
            {% set end = null %}

            {% for idx,item in schedule.scheduledItems %}
                <tbody class="{{ idx % 2 ? 'h-odd' : 'h-even' }} h-i-l{{ item.getWidth(columns) }}">
                    {% if idx > 0 and old != item.scheduled.format('d') %}
                        <tr class="h-new-day info">
                            <td colspan="{{ numCols + 2 }}">{{ item.scheduled.format('l, F d, Y') }}</td>
                        </tr>
                    {% endif %}

                    <tr class="h-primary">
                        {% set extra = item.extra %}
                        <td class="h-s">
                            <time
                                datetime="{{ item.scheduled.format('Y-m-d\\TH:i:sP') }}">{{ item.scheduled.format(dtformat) }}</time>
                        </td>
                        <td class="h-0">{{ utils.markdown(extra[columns[0].id]|default(''))|raw }}</td>
                        <td class="h-l">
                            <time datetime="{{ item.isoDuration }}">{{ item.length.format('H:i:s') }}</time>
                        </td>
                        {% for idx,column in columns.slice(1) %}
                            <td class="h-{{ idx }}">{{ utils.markdown(extra[column.id]|default(''))|raw }}</td>
                        {% endfor %}
                    </tr>

                    {% set old = item.scheduled.format('d') %}
                    {% set end = item %}
                </tbody>
            {% endfor %}
        </table>

        <div class="row">
            <div class="col-lg-12 text-center">
                {% set endDate = end.scheduledEnd %}
                <h4>Ends at <strong itemprop="endDate">
                        <time datetime="{{ endDate.format('Y-m-d\\TH:i:sP') }}" class="h-fancy-time"
                              id="h-schedule-end">{{ endDate.format('H:i:s') }}</time>
                    </strong></h4>
            </div>
        </div>
    </div>

    <script type="text/html" id="ticker">
        <div class="col-lg-4 offset-lg-2 col-md-4 offset-md-2 col-sm-5 offset-sm-1">
            <div class="card border-success h-current">
                <div class="card-header">
                    <h3 class="card-title float-right"><a href="#" class="h-jumper">jump to <i class="fa-solid fa-angles-down"></i></a></h3>
                    <h3 class="card-title">Currently showing:</h3>
                </div>
                <div class="card-body">&nbsp;</div>
            </div>
        </div>

        <div class="col-lg-4 col-md-4 col-sm-5">
            <div class="card h-next">
                <div class="card-header">
                    <h3 class="card-title">Next up
                        <time datetime="{{ start.format('Y-m-d\\TH:i:sP') }}" class="h-relative"></time>
                                            :
                    </h3>
                </div>
                <div class="card-body">&nbsp;</div>
            </div>
        </div>
    </script>

    {% if numCols > 1 %}
        <script type="text/html" id="toggler">
            <div class="text-right h-l{{ schedule.getMaxItemWidth(columns) }}">
                <button class="btn-link btn-sm btn-secondary h-co" id="h-toggle-usability"><i class="fa-solid fa-table"></i>
                    Toggle full view
                </button>
            </div>
        </script>

        <script type="text/html" id="controls">
            <td class="h-co">
                <button class="btn btn-link btn-sm" rel="more"><i class="fa-solid fa-angles-down"></i> more</button>
                <button class="btn btn-link btn-sm" rel="less"><i class="fa-solid fa-angles-up"></i> less</button>
                <button class="btn btn-link btn-sm" disabled><i class="fa-solid fa-angles-down"></i> more</button>
            </td>
        </script>

        <script type="text/html" id="expanded_tpl">
            <tr class="h-secondary">
                <td colspan="{{ numCols + 3 }}">
                    <dl class="row">
                        <dt class="h-e-l">{{ schedule.text('col-estimate')|default('Estimate') }}:</dt>
                        <dd class="h-e-l">&nbsp;</dd>
                        {% for idx,column in columns.slice(1) %}
                            <dt class="h-e-{{ idx }}">{{ column.name }}:</dt>
                            <dd class="h-e-{{ idx }}">&nbsp;</dd>
                        {% endfor %}
                    </dl>
                </td>
            </tr>
        </script>
    {% endif %}
    {% endif %}
{% endblock %}
