{% extends "frontend/layout.twig" %}
{% import "macros.twig" as macros %}

{% set theme    = event.theme              %}
{% set appendix = key ? '?key=' ~ key : '' %}

{% block fulltitle %}{{ event.name }}{% endblock %}
{% block body_attr %} class="theme-{{ theme }}"{% endblock %}

{% block meta %}
<meta name="description" content="A list of schedules created for {{ event.name }}">
	<meta name="author" content="{{ event.owner.displayName }}">
	<link rel="index" href="{{ app.request.scheme }}://{{ app.request.host }}/{{ event.slug ~ appendix }}">
	{% if isPrivate %}<meta name="robots" content="noindex">
{% endif %}
{% endblock %}

{% block styles %}
<link href="{{ macros.asset('css/theme-' ~ theme ~ '.min.css') }}" rel="stylesheet">
<link rel="stylesheet" href="{{ macros.asset('vendor/@fortawesome/fontawesome-free/css/fontawesome.min.css') }}"/>
<link href="{{ macros.asset('css/app-frontend.min.css') }}" rel="stylesheet">
{% endblock %}

{% block navheader %}
<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#h-collapse-nav" aria-controls="h-collapse-nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
<a href="/{{ event.slug ~ appendix }}" class="navbar-brand">{{ event.name }}</a>
{% endblock %}

{% block navigation %}
<ul class="navbar-nav mr-auto">
	{% if schedules|length == 1 %}
	<li class="nav-item"><a href="/{{ event.slug }}/{{ schedules[0].slug ~ appendix }}" class="nav-link h-jail"><i class="fa-regular fa-calendar-days"></i> {{ schedules[0].name == event.name ? 'Schedule' : schedules[0].name }}</a></li>
	{% elseif schedules|length != 0 %}
	<li class="nav-item dropdown">
		<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-regular fa-calendar-days"></i> Schedules</a>
		<div class="dropdown-menu">
			{% for sched in schedules %}
			<a href="/{{ event.slug }}/{{ sched.slug ~ appendix }}" class="dropdown-item h-jail">{{ sched.name }}</a>
			{% endfor %}
		</div>
	</li>
	{%	endif %}
</ul>

<ul class="navbar-nav ml-auto">
	{% if event.website %}<li class="nav-item"><a href="{{ event.website }}" target="_blank" title="{{ event.website }}" class="nav-link"><i class="fa-solid fa-globe"></i> <span class="d-none d-md-inline">Website</span></a></li>{% endif %}
	{% if event.twitch %}<li class="nav-item"><a href="https://twitch.tv/{{ event.twitch }}" target="_blank" title="{{ event.twitch }}" class="nav-link"><i class="fa-brands fa-twitch"></i> <span class="d-none d-md-inline">{{ event.twitch }}</span></a></li>{% endif %}
    {% if event.bluesky %}<li class="nav-item"><a href="https://bsky.app/profile/{{ event.bluesky }}" target="_blank" title="@{{ event.bluesky }}" class="nav-link"><i class="fa-brands fa-bluesky"></i> <span class="d-none d-md-inline">@{{ event.bluesky }}</span></a></li>{% endif %}
	{% if event.twitter %}<li class="nav-item"><a href="https://twitter.com/{{ event.twitter }}" target="_blank" title="@{{ event.twitter }}" class="nav-link"><i class="fa-brands fa-twitter"></i> <span class="d-none d-md-inline">{{ event.twitter }}</span></a></li>{% endif %}
</ul>
{% endblock %}

{% block content %}
<div class="row">
	<div class="col-lg-4 offset-lg-4 col-md-4 offset-md-4 col-sm-4 offset-sm-4 col-4 offset-4">
		<p class="text-center">
			<img src="{{ macros.asset('images/error-404.png') }}" alt="Schedule Not Found" class="img-fluid">
		</p>
	</div>
</div>
{% endblock %}

{% block scripts %}
    {# TODO: find a way to get rid of fontawesome scripts, I don't like them and it should not be needed #}
    <script src="{{ macros.asset('vendor/@fortawesome/fontawesome-free/js/all.min.js') }}"></script>
{% endblock %}
