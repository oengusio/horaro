{% import "macros.twig" as macros %}

{% if not app.user %}
	{% if oauth_settings is empty %}
	<form method="post" action="/-/login" class="form-inline ml-auto">
		<div class="form-group">
			<input type="text" name="login" placeholder="username" class="form-control" required>
		</div>
		<div class="form-group">
			<input type="password" name="password" placeholder="password" class="form-control" required>
		</div>
		<div class="form-group">
			<button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-arrow-right-to-bracket"></i> Log-in</button>
		</div>
	</form>
	{% else %}
	<ul class="navbar-nav ml-auto">
		<li class="nav-item">
			<a href="/-/login" class="nav-link"><i class="fa-solid fa-arrow-right-to-bracket"></i> Log-in</a>
		</li>
	</ul>
	{% endif %}
{% elseif app.session.get('navbar') == 'admin' %}
	<ul class="navbar-nav mr-auto">
		<li class="nav-item"><a href="/-/admin" class="nav-link"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
		<li class="nav-item"><a href="/-/admin/users" class="nav-link"><i class="fa-solid fa-users"></i> Users</a></li>
		<li class="nav-item"><a href="/-/admin/events" class="nav-link"><i class="fa-solid fa-gamepad"></i> Events</a></li>
		<li class="nav-item"><a href="/-/admin/schedules" class="nav-link"><i class="fa-regular fa-calendar-days"></i> Schedules</a></li>
		{% if utils.userIsOp %}
		<li class="nav-item"><a href="/-/admin/utils" class="nav-link"><i class="fa-solid fa-wand-magic"></i> Utilities</a></li>
		{% endif %}
	</ul>

	<ul class="navbar-nav ml-auto">
		<li class="nav-item">
            <form method="post" class="form-inline" action="/-/logout">
                {{ macros.csrf_token() }}
                <button type="submit" class="btn btn-link nav-link pt-2 pb-0"><i class="fa-solid fa-power-off"></i> Log-out</button>
            </form>
		</li>
		<li class="nav-item">
			<a href="/-/home" class="nav-link"><i class="fa-solid fa-house"></i> <span class="d-block d-sm-none">Regular Backend</span></a>
		</li>
	</ul>
{% else %}
	<ul class="navbar-nav mr-auto">
		<li class="nav-item"><a href="/-/home" class="nav-link"><i class="fa-solid fa-house"></i> Home</a></li>
		<li class="nav-item dropdown">
			<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-solid fa-gamepad"></i> My Events</a>
			<div class="dropdown-menu">
				{% for event in app.user.events %}
				<a href="/-/events/{{ event.id|obscurify('event') }}" class="dropdown-item h-jail">{{ event.name }}</a>
				{% endfor %}

				{% if app.user.events|length > 0 %}
				<div class="dropdown-divider"></div>
				{% endif %}
				<a href="/-/events/new" class="dropdown-item">New…</a>
			</div>
		</li>
		<li class="nav-item dropdown">
			<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa-regular fa-calendar-days"></i> My Schedules</a>
			<div class="dropdown-menu">
				{% for event in app.user.events %}
					{% for schedule in event.schedules %}
					<a href="/-/schedules/{{ schedule.id|obscurify('schedule') }}" class="dropdown-item h-jail">{{ schedule.name|shorten(20) }} <small>({{ event.name|shorten(35) }})</small></a>
					{% endfor %}
				{% endfor %}

				{% if app.user.events|length > 0 %}
				<div class="dropdown-divider"></div>
				{% endif %}
			</div>
		</li>
	</ul>

	<ul class="navbar-nav ml-auto">
		<li class="nav-item">
			<a href="/-/profile" class="nav-link h-jail">
				<i class="fa-solid fa-gear"></i>
				{{ app.user.name }}
				{% if app.user.gravatarHash %}
				<img src="//www.gravatar.com/avatar/{{ app.user.gravatarHash }}?size=23&amp;d=retro&amp;r=pg" class="h-avatar" alt="" />
				{% endif %}
			</a>
		</li>
		<li class="nav-item">
            <form method="post" class="form-inline" action="/-/logout">
                {{ macros.csrf_token() }}
                <button type="submit" class="btn btn-link nav-link pt-2 pb-0"><i class="fa-solid fa-power-off"></i> Log-out</button>
            </form>
		</li>
		{% if utils.userIsAdmin() %}
		<li class="nav-item">
			<a href="/-/admin" class="nav-link"><i class="fa-solid fa-wrench"></i> <span class="d-block d-sm-none">Admin Dashboard</span></a>
		</li>
		{% endif %}
	</ul>
{% endif %}
