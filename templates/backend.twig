{% extends "layout.twig" %}
{% import "macros.twig" as macros %}

{% block styles %}
{{ macros.csrf_token_meta() }}
{# TODO: what's in this vendor compilation again? #}
{#<link href="{{ macros.asset('styles/vendor-backend.css') }}" rel="stylesheet">#}
<link href="{{ asset('vendor/bootswatch/dist/yeti/bootstrap.min.css') }}" rel="stylesheet">
<link rel="stylesheet" href="{{ macros.asset('vendor/@fortawesome/fontawesome-free/css/fontawesome.min.css') }}"/>
<link href="//cdnjs.cloudflare.com/ajax/libs/x-editable/1.5.1/bootstrap3-editable/css/bootstrap-editable.css" rel="stylesheet">
<link href="//cdnjs.cloudflare.com/ajax/libs/select2/3.5.0/select2.min.css" rel="stylesheet">
<link href="//cdnjs.cloudflare.com/ajax/libs/select2/3.5.0/select2-bootstrap.min.css" rel="stylesheet">
<link href="{{ macros.asset('styles/app-backend.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
<script type="module" src="{{ macros.asset('vendor/jquery/jquery.index.js') }}"></script>
<script type="module" src="{{ macros.asset('vendor/bootstrap/bootstrap.index.js') }}"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/knockout/3.2.0/knockout-min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/x-editable/1.5.1/bootstrap3-editable/js/bootstrap-editable.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/select2/3.5.0/select2.min.js"></script>
<script src="//cdn.jsdelivr.net/remarkable/1.6.0/remarkable.min.js"></script>
<script src="{{ macros.asset('js/vendor-backend.js') }}"></script>
<script src="{{ macros.asset('js/i18n/' ~ app.locale ~ '.js') }}"></script>
{# TODO: find a way to get rid of fontawesome scripts, I don't like them and it should not be needed #}
<script src="{{ macros.asset('vendor/@fortawesome/fontawesome-free/js/all.min.js') }}"></script>
<script src="{{ macros.asset('js/app-backend.js') }}"></script>
<script src="{{ macros.asset('js/readableTimeJs.js') }}"></script>
{% endblock %}
