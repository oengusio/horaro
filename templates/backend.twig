{% extends "layout.twig" %}
{% import "macros.twig" as macros %}

{% block styles %}
{{ macros.csrf_token_meta() }}
<link href="{{ asset('vendor/bootswatch/dist/yeti/bootstrap.min.css') }}" rel="stylesheet">
<link rel="stylesheet" href="{{ macros.asset('vendor/@fortawesome/fontawesome-free/css/fontawesome.min.css') }}"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/3.5.0/select2.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/3.5.0/select2-bootstrap.min.css" rel="stylesheet">
<link href="{{ macros.asset('styles/app-backend.css') }}" rel="stylesheet">
{% endblock %}

{% block scripts %}
{% block importmap %}{{ importmap('backend') }}{% endblock %}

<script src="{{ macros.asset('js/i18n/' ~ app.locale ~ '.js') }}"></script>
{# TODO: find a way to get rid of fontawesome scripts, I don't like them and it should not be needed #}
<script src="{{ macros.asset('vendor/@fortawesome/fontawesome-free/js/all.min.js') }}"></script>
{#<script src="{{ macros.asset('js/readableTimeJs.js') }}"></script>#}
{% endblock %}
