{% extends "backend.twig" %}

{% block title %}Home{% endblock %}

{% block content %}
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
        <li class="breadcrumb-item active">Home</li>
    </ol></nav>

    <div class="row">
        <div class="col-lg-12">
            <h2>My Events</h2>
        </div>
    </div>

    <div class="row h-tiles">
        {% for event in app.user.events %}
            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                <div class="card card-body">
                    <div>
                        <h4><a href="/-/events/{{ event.id|obscurify('event') }}">
                                <span class="pr-2"><i class="fa-solid fa-gamepad fa-3x"></i></span>
                                <span>{{ event.name|shorten(55) }}</span>
                            </a></h4>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if not isFull %}
            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                <div class="card card-body h-adder">
                    <div>
                        <h4><a href="/-/events/new" class="text-muted">
                                <span><i class="fa-solid fa-plus fa-3x"></i></span>
                                <span>New…</span>
                            </a></h4>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {% if isFull %}
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info"></i> You have reached the maximum number of allowed events for your account.<br>
                                              An <a href="/-/contact">administrator</a> can increase your limits.
        </div>
    {% endif %}
{% endblock %}
