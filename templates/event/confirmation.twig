{% extends "backend.twig" %}
{% import "macros.twig" as macros %}

{% block title %}{{ event.name }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb"><ol class="breadcrumb h-jail">
	<li class="breadcrumb-item"><a href="/-/home">Home</a></li>
	<li class="breadcrumb-item"><a href="/-/events/{{ event.id|obscurify('event') }}">{{ event.name|shorten(45) }}</a></li>
	<li class="breadcrumb-item active">Delete Event</li>
</ol></nav>

<div class="row">
	<div class="col-lg-12">
		<h2 class="h-jail">You are about to delete &quot;{{ event.name }}&quot;!</h2>
		<p>Deleting an event will delete all associated data, i.e. schedules.<br>
		<strong>There is no un-do for this.</strong></p>
	</div>
</div>

<div class="row">
	<div class="col-lg-3 offset-lg-3 col-md-3 offset-md-3 col-sm-4 offset-sm-2 col-6 text-right">
		<a href="/-/events/{{ event.id|obscurify('event') }}" class="btn btn-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i> No thanks</a>
	</div>

	<div class="col-lg-3 col-md-3 col-sm-4 col-6">
		<form method="post" action="/-/events/{{ event.id|obscurify('event') }}">
			<div>
				{{ macros.csrf_token() }}
				<input type="hidden" id="_method" name="_method" value="DELETE" />
				<button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Yes, kill it!</button>
			</div>
		</form>
	</div>
</div>

{% endblock %}
